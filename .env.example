# Copy to .env and fill in values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas — include database name in path, e.g. ...mongodb.net/video_sensitivity?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/video_sensitivity?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Optional: allow your Vite dev origin
CORS_ORIGIN=http://localhost:5173

# Cloudinary (video upload → secure_url stored in DB, played on home feed)
CLOUDINARY_CLOUD_NAME=your_cloud_name_from_dashboard
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Cloud Vision — enable Vision API in GCP; used after upload (FFmpeg frames → Safe Search)
GOOGLE_CLOUD_VISION_API_KEY=

# Streaming: proxy (default) forwards Range to CDN; redirect = 302 only (less server bandwidth)
# VIDEO_STREAM_MODE=proxy
# VIDEO_STREAM_MODE=redirect
